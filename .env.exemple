# Port d'écoute de l'API Express.
PORT=3000

# Clé secrète pour signer les tokens JWT.
# Utilisez une longue chaîne aléatoire, par exemple : openssl rand -hex 32
SECRET=remplacez_par_une_chaine_aleatoire

# Chaîne de connexion MongoDB Atlas.
# Dans Atlas : Database > Connect > Drivers, puis copiez l'URI.
# Pensez à remplacer <password> et à autoriser votre IP (Network Access).
# Format : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/taskly?retryWrites=true&w=majority